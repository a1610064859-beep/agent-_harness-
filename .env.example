# Copy to .env and fill in your own key. Never commit .env.
# Any OpenAI-compatible chat/completions endpoint with tool calling works
# (DeepSeek, Qwen, the organizer's unified key, ...).
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Optional: reasoning effort if the provider supports it (low / high / max)
# LLM_EFFORT=low
# Optional: fix the business date for reproducible demos (default: today)
FH_TODAY=2026-10-26
# Optional, testing only: allow importing invoicegen test samples (TEST numbers)
# FH_ALLOW_TEST_SAMPLES=1
# Optional: scanned/image invoices via MinerU on this PC (scripts\setup-ocr.bat fills these in)
# FH_OCR=mineru
# FH_MINERU_BIN=C:\path\to\.ocr\venv\Scripts\mineru.exe
# FH_OCR_TIER=standard
